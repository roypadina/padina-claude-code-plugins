{
  "metadata": {
    "name": "Hebrew-English Keyboard Mapping",
    "description": "Bidirectional character mapping between US QWERTY and Israeli SI-1452 Hebrew keyboard layouts. Use to repair text typed with the wrong active layout.",
    "layouts": {
      "en": "US QWERTY",
      "he": "Israeli SI-1452"
    },
    "notes": [
      "Each map: key = char the user got, value = char they intended on the other layout.",
      "Hebrew has no letter case; uppercase Latin (A-Z) maps to the same Hebrew letter as lowercase.",
      "Most shifted symbols (!@#$%^&*_+:|?~) are identical on both layouts.",
      "Brackets [] and {}, parentheses (), and angle brackets <> SWAP between layouts (Hebrew is RTL).",
      "Number digits 0-9 and space are identical on both layouts.",
      "Identity mappings are included so a lookup never returns undefined."
    ]
  },
  "en_to_he": {
    "q": "/",  "w": "'",  "e": "ק", "r": "ר", "t": "א", "y": "ט", "u": "ו", "i": "ן", "o": "ם", "p": "פ",
    "a": "ש", "s": "ד", "d": "ג", "f": "כ", "g": "ע", "h": "י", "j": "ח", "k": "ל", "l": "ך",
    "z": "ז", "x": "ס", "c": "ב", "v": "ה", "b": "נ", "n": "מ", "m": "צ",

    "Q": "/",  "W": "'",  "E": "ק", "R": "ר", "T": "א", "Y": "ט", "U": "ו", "I": "ן", "O": "ם", "P": "פ",
    "A": "ש", "S": "ד", "D": "ג", "F": "כ", "G": "ע", "H": "י", "J": "ח", "K": "ל", "L": "ך",
    "Z": "ז", "X": "ס", "C": "ב", "V": "ה", "B": "נ", "N": "מ", "M": "צ",

    "`": ";",
    "-": "-",
    "=": "=",
    "[": "]",
    "]": "[",
    "\\": "\\",
    ";": "ף",
    "'": ",",
    ",": "ת",
    ".": "ץ",
    "/": ".",

    "~": "~",
    "!": "!",
    "@": "@",
    "#": "#",
    "$": "$",
    "%": "%",
