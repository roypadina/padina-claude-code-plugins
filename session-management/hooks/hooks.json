{
  "description": "session-management: a bare `close` reply after /finish-session gets the close instructions injected, so it works even after /compact; at every turn end `~/.claude/bin/claudwork touch` stamps the session's work folder, when that script exists.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"${CLAUDE_PLUGIN_ROOT}/scripts/close-trigger.sh\" && bash \"${CLAUDE_PLUGIN_ROOT}/scripts/close-trigger.sh\" || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"$HOME/.claude/bin/claudwork\" && \"$HOME/.claude/bin/claudwork\" touch || exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
